ao:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A sovereign country (ISO 3166-1 alpha-2)." .

ao:Region a owl:Class ;
    rdfs:label "Region" ;
    rdfs:comment "An administrative region or state (ISO 3166-2)." .

