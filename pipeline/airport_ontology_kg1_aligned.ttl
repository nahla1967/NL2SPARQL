@prefix ao: <http://www.semanticweb.org/ontologies/airport_ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/ontologies/airport_ontology> a owl:Ontology ;
    rdfs:label "KG2 — Airport Knowledge Graph" ;
    rdfs:comment "Exactly 58 airports that appear as origin or destination in KG1 flights. Every airport in this graph is linked to at least one real flight. Source: OurAirports open data." .

ao:airportName a owl:DatatypeProperty ;
    rdfs:comment "Full official name" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:string .

ao:airportType a owl:DatatypeProperty ;
    rdfs:comment "large_airport or medium_airport" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:string .

ao:belongsToAirport a owl:ObjectProperty ;
    rdfs:comment "Inverse of hasRunway." ;
    rdfs:domain ao:Runway ;
    rdfs:range ao:Airport ;
    owl:inverseOf ao:hasRunway .

ao:closed a owl:DatatypeProperty ;
    rdfs:comment "True if runway is permanently closed" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:boolean .

ao:continent a owl:DatatypeProperty ;
    rdfs:comment "Two-letter continent code" ;
    rdfs:domain ao:Country ;
    rdfs:range xsd:string .

ao:countryName a owl:DatatypeProperty ;
    rdfs:comment "Full country name in English" ;
    rdfs:domain ao:Country ;
    rdfs:range xsd:string .

ao:elevationFt a owl:DatatypeProperty ;
    rdfs:comment "Elevation above sea level in feet" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:integer .

ao:iataCode a owl:DatatypeProperty ;
    rdfs:comment "IATA 3-letter code" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:string .

ao:icaoCode a owl:DatatypeProperty ;
    rdfs:comment "ICAO 4-letter code" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:string .

ao:isoCode a owl:DatatypeProperty ;
    rdfs:comment "ISO 3166-1 alpha-2 country code" ;
    rdfs:domain ao:Country ;
    rdfs:range xsd:string .

ao:latitude a owl:DatatypeProperty ;
    rdfs:comment "Latitude in decimal degrees WGS84" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:decimal .

ao:lengthFt a owl:DatatypeProperty ;
    rdfs:comment "Runway length in feet" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:integer .

ao:lighted a owl:DatatypeProperty ;
    rdfs:comment "True if runway has lighting" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:boolean .

ao:locatedInCountry a owl:ObjectProperty ;
    rdfs:comment "Links an Airport to its Country." ;
    rdfs:domain ao:Airport ;
    rdfs:range ao:Country .

ao:locatedInRegion a owl:ObjectProperty ;
    rdfs:comment "Links an Airport to its Region." ;
    rdfs:domain ao:Airport ;
    rdfs:range ao:Region .

ao:longitude a owl:DatatypeProperty ;
    rdfs:comment "Longitude in decimal degrees WGS84" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:decimal .

ao:municipality a owl:DatatypeProperty ;
    rdfs:comment "City served by this airport" ;
    rdfs:domain ao:Airport ;
    rdfs:range xsd:string .

ao:regionCode a owl:DatatypeProperty ;
    rdfs:comment "ISO 3166-2 region code" ;
    rdfs:domain ao:Region ;
    rdfs:range xsd:string .

ao:regionName a owl:DatatypeProperty ;
    rdfs:comment "Full region or state name" ;
    rdfs:domain ao:Region ;
    rdfs:range xsd:string .

ao:runwayIdent a owl:DatatypeProperty ;
    rdfs:comment "Runway heading identifier e.g. 07L" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:string .

ao:surface a owl:DatatypeProperty ;
    rdfs:comment "Surface material ASP CON GRS" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:string .

ao:widthFt a owl:DatatypeProperty ;
    rdfs:comment "Runway width in feet" ;
    rdfs:domain ao:Runway ;
    rdfs:range xsd:integer .

